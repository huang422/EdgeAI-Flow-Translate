@MainActor final class CaptureViewModel: ObservableObject {
  @Published var settings = CaptionSettings.default
  let activePromptRulebookIgnoringCategories = PromptStdlib.all
  let promptEval = FixtureEval()
  var isResettingPermissions = false
  var permissionResetTask: Task<Permissions.ResetReport, Never>?
  var sourceGenerations: [AudioSourceType: UInt64] = [:]
  let router: AudioRouter
  let echoLock = NSLock()
  var systemSourceOn = false
  var micEnabled = false
  var systemEnabled = false
  var statusMessage = ""
  var statusAction: PermissionPane?
  enum ASRState { case idle, loading }
  var asrState = ASRState.idle
  var levels = Levels()
  struct Levels {
    var mic = 0
    var system = 0
  }
  let resetGate: CaptureGate?
  var audioSourcesLocked: Bool { isResettingPermissions }
  let settingsPresentationSize = CGSize(width: 470, height: 420)

  init(router: AudioRouter = AudioRouter(), resetGate: CaptureGate? = nil) {
    self.router = router
    self.resetGate = resetGate
  }

  func drainPromptWorkloads() async { await resetGate?.pause() }
  func endMeeting() async {}
  func cancelRecognitionStartup() {}
  // INSERT: toggleSystem
  // INSERT: resetPrivacyPermissions
  func uninstall() {}

  private static let log = Logger()
  private weak var boundWindow: NSWindow?
  private let controlWindows = NSHashTable<NSWindow>.weakObjects()
  private var windowCloseObserver: NSObjectProtocol?
  private var controlWindowClosed = false
  private var terminationRequested = false
  private var closeResourcesTask: Task<Void, Never>?
  private var summaryTask: Task<Void, Never>?
  private var acceptingTranslations = true
  private var acceptingCorrections = true
  private var captionPrewarmInProgress = false
  private let asr = FixtureWeights()
  private let qwenHost = FixtureWeights()
  private let store: TranscriptStoring = InMemoryTranscriptStore()
  private var overlayOn = true
  private var rewarmCount = 0

  func releaseQwen() async {
    await drainPromptWorkloads()
    qwenHost.releaseModels()
  }
  func prepareForCaptions(refresh: Bool) {
    guard !controlWindowClosed, !terminationRequested, closeResourcesTask == nil else { return }
    rewarmCount += 1
    asr.isWarm = true
  }
  // INSERT: prepareForTermination
  // INSERT: bindMainWindow
  // INSERT: handleWindowClosed
  // INSERT: beginClosingResources

  func checkResourceClose() async {
    func makeWindow() -> NSWindow {
      let window = DiagnosticWindow(
        contentRect: NSRect(x: -20000, y: -20000, width: 640, height: 520),
        styleMask: [.titled, .closable], backing: .buffered, defer: false)
      window.isReleasedWhenClosed = false
      window.orderBack(nil)
      bindMainWindow(window)
      return window
    }
    let first = makeWindow()
    let second = makeWindow()
    asr.isWarm = true
    qwenHost.isWarm = true
    let releases = asr.releases
    first.close()
    check(asr.isWarm && closeResourcesTask == nil, "closing one of two control windows keeps the active window ready")
    second.close()
    let closing = closeResourcesTask
    await closing?.value
    check(!overlayOn && !asr.isWarm && !qwenHost.isLoaded && rewarmCount == 0
      && asr.releases == releases + 1 && router.activeSources.isEmpty,
      "closing an idle control window releases both models and stops automatic prewarm")

    let reopened = makeWindow()
    let before = rewarmCount
    var summaryEntered = false
    summaryTask = Task { [self] in
      summaryEntered = true
      try? await Task.sleep(for: .seconds(5))
      qwenHost.isWarm = true // completes native work even if the task was cancelled
    }
    while !summaryEntered { await Task.yield() }
    reopened.close()
    let secondClose = closeResourcesTask
    let latest = makeWindow()  // user reopens before the cleanup finishes
    await secondClose?.value
    check(asr.isWarm && rewarmCount == before + 1 && !qwenHost.isLoaded,
      "rapid reopen prewarms only after cancelled summary releases Qwen")

    await prepareForTermination()
    check(!asr.isWarm && !qwenHost.isLoaded && rewarmCount == before + 1,
      "termination releases models without scheduling another preload")
    latest.orderOut(nil)
    if let windowCloseObserver { NotificationCenter.default.removeObserver(windowCloseObserver) }
  }
}

private final class FixtureWeights {
  var isWarm = false
  var isLoaded: Bool { isWarm }
  var releases = 0
  func releaseModels() { isWarm = false; releases += 1 }
}

struct FixtureEval {
  struct Progress {
    var done: Int
    var total: Int
    var currentCase: String
  }
  var progress: Progress? { nil }
  var tokenAccuracy: String { "" }
  var statusMessage: String { "" }
  var pasteableReport: String? { nil }
  func cancel() {}
  func run() {}
}

